#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

failed=0

ignored_tracked="$(git ls-files --cached --ignored --exclude-standard)"
if [[ -n "$ignored_tracked" ]]; then
    printf 'error: ignored files are tracked:\n%s\n' "$ignored_tracked" >&2
    failed=1
fi

artifact_pattern='(^|/)(perf\.data.*|flamegraph.*\.svg|profile.*\.json(\.gz)?|callgrind\.out.*)$|\.(profraw|profdata)$'
tracked_artifacts="$(git ls-files | grep -E "$artifact_pattern" || true)"
if [[ -n "$tracked_artifacts" ]]; then
    printf 'error: generated profiling artifacts are tracked:\n%s\n' "$tracked_artifacts" >&2
    failed=1
fi

while IFS= read -r -d '' path; do
    size="$(git cat-file -s ":$path")"
    if (( size > 5 * 1024 * 1024 )); then
        printf 'error: tracked file exceeds 5 MiB (%s bytes): %s\n' "$size" "$path" >&2
        failed=1
    fi
done < <(git ls-files -z)

if (( failed != 0 )); then
    exit 1
fi

printf 'Repository hygiene checks passed.\n'
